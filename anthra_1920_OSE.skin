<display id="channelInfo">
	<window x1="96" x2="1824" y1="639" y2="817" bpp="8" />
	<window x1="96" x2="1824" y1="818" y2="979" bpp="8" />
	<window x1="96" x2="1824" y1="980" y2="1020" bpp="8" />
	
		<image   x1="96" x2="1824" y1="750"  y2="817" colors="128"  path="images/progressChannel.png"/>	
		<rectangle x1="96" x2="1824" y1="817" y2="980"  color="Background" />
		

<!--SEPARATORLOGOS-LEFT-->	<block condition="not({ChannelNumber})">
<!--SEPARATORLOGOS-LEFT-->		<image x1="130" x2="390" y1="821"  y2="967" condition="file('../Separatorlogos/{ChannelName}.png')" path="../Separatorlogos/{ChannelName}.png"/>
<!--SEPARATORLOGOS-LEFT-->		<text x1="470" x2="1650" y1="865" y2="910" color="TextDescr" font="VDRSymbols Sans:Book@45">{ChannelName}</text>
<!--SEPARATORLOGOS-LEFT-->		<ellipse x1="130" x2="134" y1="821" y2="825"   arc="-2" color="Background"/>
<!--SEPARATORLOGOS-LEFT-->		<ellipse x1="130" x2="134" y1="963" y2="967"   arc="-3" color="Background"/>
<!--SEPARATORLOGOS-LEFT-->		<ellipse x1="386" x2="390" y1="821" y2="825"   arc="-1" color="Background"/>
<!--SEPARATORLOGOS-LEFT-->		<ellipse x1="386" x2="390" y1="963" y2="967"   arc="-4" color="Background"/>
<!--SEPARATORLOGOS-LEFT-->	</block>


<!--LOGOSLEFT-->	<text x1="130" x2="390" y1="755" y2="790" color="TextButton" align="center" font="VDRSymbols Sans:Book@35">{ChannelNumber}</text>
<!--LOGOSLEFT-->	<block condition="{ChannelNumber}">
<!--LOGOSLEFT-->		<text x1="411" x2="1000" y1="755" y2="790" color="TextButton" font="VDRSymbols Sans:Book@35">{ChannelName}</text>
<!--LOGOSLEFT-->		<image x1="130" x2="390" y1="821"  y2="967" condition="file('/var/lib/vdr/anthralogos/{ChannelName}.png')" path="/var/lib/vdr/anthralogos/{ChannelName}.png"/>
<!--LOGOSLEFT-->		<image x1="130" x2="390" y1="821"  y2="967" condition="file('/var/lib/vdr/anthralogos/{ChannelID}.png')" path="/var/lib/vdr/anthralogos/{ChannelID}.png"/>
<!--LOGOSLEFT-->		<image x1="130" x2="390" y1="821"  y2="987" condition="not(or(file('/var/lib/vdr/anthralogos/{ChannelName}.png'),file('/var/lib/vdr/anthralogos/{ChannelID}.png')))" path="images/logobg.png"/>
<!--LOGOSLEFT-->		<ellipse x1="130" x2="137" y1="821" y2="828"   arc="-2" color="Background"/>
<!--LOGOSLEFT-->		<ellipse x1="130" x2="137" y1="960" y2="967"   arc="-3" color="Background"/>
<!--LOGOSLEFT-->		<ellipse x1="384" x2="390" y1="821" y2="827"   arc="-1" color="Background"/>
<!--LOGOSLEFT-->		<ellipse x1="384" x2="390" y1="961" y2="967"   arc="-4" color="Background"/>
<!--LOGOSLEFT-->	</block>
<!--LOGOSLEFT-->	<text x1="411" x2="520" y1="820" y2="852" color="TextDescr" font="VDRSymbols Sans:Book@32">{PresentStartDateTime:%H\:%M}</text>
<!--LOGOSLEFT-->	<blink x1="411" x2="520" y1="820" y2="852" delay="3000" color="TextDescr" font="VDRSymbols Sans:Book@32">{PresentStartDateTime:%H\:%M}</blink>
<!--LOGOSLEFT-->	<text x1="521" x2="1630" y1="820" y2="852" color="TextDescr" font="VDRSymbols Sans:Book@32">{PresentTitle}</text>
<!--LOGOSLEFT-->	<text x1="1640" x2="1755" y1="820" y2="850" condition="{PresentRemaining}" color="TextDescr" align="right" font="VDRSymbols Sans:Book@27">{PresentRemaining:%m}/{PresentDuration:%m}</text>
<!--LOGOSLEFT-->	<text x1="1760" x2="1800" y1="825" y2="850" condition="{PresentRemaining}" color="TextDescr" align="left" font="VDRSymbols Sans:Book@22">min</text>
<!--LOGOSLEFT-->	<text x1="580" x2="1740" y1="860" y2="890" color="TextDescr" align ="left" font="VDRSymbols Sans:Book@27">{PresentShortText}</text>		
<!--LOGOSLEFT-->	<text x1="411" x2="520" y1="900" y2="935" color="TextButton" font="VDRSymbols Sans:Book@32">{FollowingStartDateTime:%H\:%M}</text>
<!--LOGOSLEFT-->	<text x1="521" x2="1690" y1="900" y2="935" color="TextButton" font="VDRSymbols Sans:Book@32">{FollowingTitle}</text>
<!--LOGOSLEFT-->	<text x1="1700" x2="1755" y1="900" y2="935" condition="{FollowingDuration}" color="TextButton" align="right" font="VDRSymbols Sans:Book@27">{FollowingDuration:%m}</text>
<!--LOGOSLEFT-->	<text x1="1760" x2="1800" y1="905" y2="935" condition="{FollowingDuration}" color="TextButton" align="left" font="VDRSymbols Sans:Book@22">min</text>
<!--LOGOSLEFT-->	<text x1="580" x2="1740" y1="940" y2="970" color="TextButton" align ="left" font="VDRSymbols Sans:Book@27">{FollowingShortText}</text>
<!--LOGOSLEFT-->	<text x1="1300" x2="1630" y1="757" y2="792"  color="TextButton" align="right" font="VDRSymbols Sans:Book@30">{DateTime:%A %d.%m.%y}</text>
<!--LOGOSLEFT-->	<text x1="1660" x2="1800" y1="757" y2="792"  color="TextButton"  align="right" font="VDRSymbols Sans:Book@30">{DateTime:%H\:%M}</text>

		
		<progress  x1="131" x2="1789" y1="805" y2="812" color="BarFill" current="{PresentProgress}"  total="{PresentDuration}"/>

<!--GRAPH_SIGNAL-->		<image   x1="96" x2="1824" y1="980"  y2="1020" colors="128"  path="images/buttonsChannel_GRAPH.png"/>		
<!--GRAPH_SIGNAL-->     <progress x1="148" x2="382" y1="991" y2="994" condition="lt({FrontendSTR},33)" color="RedHigh" current="{FrontendSTR}" total="100"/>
<!--GRAPH_SIGNAL-->     <progress x1="148" x2="382" y1="991" y2="994" condition="lt({FrontendSTR},66)" color="YellowHigh" current="{FrontendSTR}" total="100"/>
