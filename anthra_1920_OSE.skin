		<text x1="956" x2="1065" y1="988" y2="1010" align="center" condition="not({HasTeletext})" color="TextLow" font="VDRSymbols Sans:Book@20">VTX</text>		
		<text x1="1067" x2="1179" y1="988" y2="1010" align="center" condition="{HasDolby}" color="TextSmallButton" font="VDRSymbols Sans:Book@20">DOLBY</text>
		<text x1="1067" x2="1179" y1="988" y2="1010" align="center" condition="not({HasDolby})" color="TextLow" font="VDRSymbols Sans:Book@20">DOLBY</text>		
		<text x1="1181" x2="1293" y1="988" y2="1010" align="center" condition="equal({AudioChannel},'stereo')" color="TextSmallButton" font="VDRSymbols Sans:Book@20">STEREO</text>
		<text x1="1181" x2="1293" y1="988" y2="1010" align="center" condition="not(equal({AudioChannel},'stereo'))" color="TextLow" font="VDRSymbols Sans:Book@20">STEREO</text>
<!--VIDEOSIZE--><text x1="1295" x2="1444" y1="988" y2="1010" align="center" condition="lt({VideoSizeHeight},1080)" color="TextSmallButton" font="VDRSymbols Sans:Book@20">{VideoSizeWidth}x{VideoSizeHeight}</text>
<!--VIDEOSIZE--><text x1="1295" x2="1444" y1="988" y2="1010" align="center" condition="equal({VideoSizeHeight},1080)" color="TextSmallButton" font="VDRSymbols Sans:Book@20">1920x1080</text>		
		<text x1="1446" x2="1558" y1="988" y2="1010" align="center"  condition="{IsEncrypted}" color="TextSmallButton" font="VDRSymbols Sans:Book@20">CRYPT</text>
		<text x1="1446" x2="1558" y1="988" y2="1010" condition="not({IsEncrypted})" align="center"   color="TextSmallButton" font="VDRSymbols Sans:Book@20">FTA</text>		
		<text x1="1560" x2="1672" y1="988" y2="1010" align="center" color="TextLow" condition="not({TimerConflicts})" font="VDRSymbols Sans:Book@20" >T-CONFL</text>
		<blink x1="1560" x2="1672" y1="988" y2="1010" align="center" color="TextSmallButton" delay="1000" condition="{TimerConflicts}" font="VDRSymbols Sans:Book@20" >T-CONFL</blink>					
		<text x1="1674" x2="1776" y1="988" y2="1010" condition="not({IsRecording})" align="center"  color="TextLow" font="VDRSymbols Sans:Book@20">REC</text>
		<blink x1="1674" x2="1776" y1="988" y2="1010" align="center" delay="600" condition="{IsRecording}" color="TextSmallButton" font="VDRSymbols Sans:Book@20">REC</blink>
		
		<block condition="{Message}">
			<image x1="96" x2="1824" y1="664" y2="725" colors="64" path="images/message.png" />	
			<text x1="0" x2="1920" y1="680" y2="707" align="center" color="GreenHigh"  font="VDRSymbols Sans:Book@27">{MessageInfo}</text>
			<text x1="0" x2="1920" y1="680" y2="707" align="center" color="BlueHigh" font="VDRSymbols Sans:Book@27">{MessageStatus}</text>
			<text x1="0" x2="1920" y1="680" y2="707" align="center" color="YellowHigh"  font="VDRSymbols Sans:Book@27">{MessageWarning}</text>
			<text x1="0" x2="1920" y1="680" y2="707" align="center" color="RedHigh"  font="VDRSymbols Sans:Book@27">{MessageError}</text>
		</block>
</display>
